-- ============ AUTO SKILL CHECK ============
local VIM
pcall(function() VIM = game:GetService("VirtualInputManager") end)
local Skill = {status = "off", root = "-", needle = "-", zone = "-", diff = "-", presses = 0}
local skillRoot, skillNeedle, skillZone
local skillLastScan, skillLastPress, skillLostSince, skillPrevSig = 0, 0, 0, 0

local function keyList(str)
    local ks = {}
    for k in string.gmatch(string.lower(tostring(str or "")), "[^,]+") do
        k = string.match(k, "^%s*(.-)%s*$")
        if k and k ~= "" then table.insert(ks, k) end
    end
    return ks
end

local function nameHas(inst, keys)
    local n = string.lower(inst.Name)
    for _, k in ipairs(keys) do
        if string.find(n, k, 1, true) then return true end
    end
    return false
end

local function guiShown(g)
    local cur = g
    while cur and cur:IsA("GuiObject") do
        if not cur.Visible then return false end
        cur = cur.Parent
    end
    if cur and cur:IsA("LayerCollector") and not cur.Enabled then return false end
    return true
end

local function findSkillRoot()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local ks = keyList(State.skillKeyword)
    if #ks == 0 then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("GuiObject") or d:IsA("LayerCollector") then
            local nm = string.lower(d.Name)
            for _, k in ipairs(ks) do
                if string.find(nm, k, 1, true) then
                    local shown
                    if d:IsA("GuiObject") then shown = guiShown(d) else shown = d.Enabled end
                    if shown then return d end
                    break
                end
            end
        end
    end
    return nil
end

local function locateSkill(root)
    local nk, zk = keyList(State.skillNeedle), keyList(State.skillZone)
    local needle, zone
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("GuiObject") then
            if not needle and nameHas(d, nk) then
                needle = d
            elseif not zone and nameHas(d, zk) then
                zone = d
            end
            if needle and zone then break end
        end
    end
    return needle, zone
end

-- true kalau needle sedang berada di zona sukses
local function skillHit(needle, zone)
    local tol = State.skillTol
    local nr, zr = needle.AbsoluteRotation, zone.AbsoluteRotation
    if math.abs(nr) > 0.5 or math.abs(zr) > 0.5 then
        -- mode putar (lingkaran)
        local diff = math.abs(((nr - zr - State.skillOffset + 180) % 360) - 180)
        return diff <= tol, ("%.1f deg"):format(diff)
    end
    -- mode garis (bar)
    local nc = needle.AbsolutePosition + needle.AbsoluteSize / 2
    local zp, zs = zone.AbsolutePosition, zone.AbsoluteSize
    if needle.AbsoluteSize.Y >= needle.AbsoluteSize.X then
        return nc.X >= zp.X - tol and nc.X <= zp.X + zs.X + tol,
            ("x=%.0f zona[%.0f-%.0f]"):format(nc.X, zp.X, zp.X + zs.X)
    else
        return nc.Y >= zp.Y - tol and nc.Y <= zp.Y + zs.Y + tol,
            ("y=%.0f zona[%.0f-%.0f]"):format(nc.Y, zp.Y, zp.Y + zs.Y)
    end
end

local function pressSkill(root)
    if State.skillSpace and VIM then
        pcall(function()
            VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            task.delay(0.03, function()
                pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game) end)
            end)
        end)
    end
    if State.skillClick and root then
        local btn
        for _, d in ipairs(root:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and guiShown(d) then
                btn = d
                break
            end
        end
        if btn then
            local c = btn.AbsolutePosition + btn.AbsoluteSize / 2
            if firesignal then
                pcall(firesignal, btn.MouseButton1Down, c.X, c.Y)
                pcall(firesignal, btn.MouseButton1Up, c.X, c.Y)
                pcall(firesignal, btn.MouseButton1Click)
                pcall(firesignal, btn.Activated)
            end
            if VIM then
                local inset = GuiService:GetGuiInset()
                pcall(function()
                    VIM:SendMouseButtonEvent(c.X, c.Y + inset.Y, 0, true, game, 0)
                    task.delay(0.03, function()
                        pcall(function() VIM:SendMouseButtonEvent(c.X, c.Y + inset.Y, 0, false, game, 0) end)
                    end)
                end)
            end
        end
    end
end

local function skillTick()
    if not State.autoSkill then Skill.status = "off" return end
    local now = tick()

    if not (skillRoot and skillRoot.Parent) then
        skillRoot, skillNeedle, skillZone = nil, nil, nil
        if now - skillLastScan >= 0.25 then
            skillLastScan = now
            skillRoot = findSkillRoot()
            if skillRoot then Skill.root = skillRoot.Name end
        end
        if not skillRoot then Skill.status = "menunggu skill check" return end
        skillLostSince = 0
    end

    if not (skillNeedle and skillNeedle.Parent and skillZone and skillZone.Parent) then
        skillNeedle, skillZone = locateSkill(skillRoot)
        Skill.needle = skillNeedle and skillNeedle.Name or "-"
        Skill.zone = skillZone and skillZone.Name or "-"
    end

    if not (skillNeedle and skillZone) then
        Skill.status = "GUI ketemu, needle/zone belum ketemu"
        if skillLostSince == 0 then skillLostSince = now
        elseif now - skillLostSince > 1.5 then skillRoot = nil skillLostSince = 0 end
        return
    end

    if not (guiShown(skillNeedle) and guiShown(skillZone)) then
        Skill.status = "skill check tidak tampil"
        if skillLostSince == 0 then skillLostSince = now
        elseif now - skillLostSince > 2 then
            skillRoot, skillNeedle, skillZone = nil, nil, nil
            skillLostSince = 0
        end
        return
    end
    skillLostSince = 0

    local sig = skillNeedle.AbsoluteRotation + skillNeedle.AbsolutePosition.X + skillNeedle.AbsolutePosition.Y
    local moving = (sig ~= skillPrevSig)
    skillPrevSig = sig

    local hit, info = skillHit(skillNeedle, skillZone)
    Skill.diff = info
    Skill.status = hit and "needle di zona" or "mengikuti needle"
    if hit and moving and now - skillLastPress >= State.skillCooldown then
        skillLastPress = now
        Skill.presses = Skill.presses + 1
        local root = skillRoot
        local d = State.skillDelay
        if d > 0 then
            task.delay(d / 1000, function() pcall(pressSkill, root) end)
        else
            pcall(pressSkill, root)
        end
        if notify then notify("Auto skill check") end
    end
end
