-- Player tick (speed, jump, bhop, fly)
local lastHum, origWS, origJP, origUse
local flyBV, flyWas = nil, false
local function playerTick()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hum ~= lastHum then lastHum = hum origWS = nil origJP = nil origUse = nil end
    if hum then
        if State.walkSpeedOn then
            if not origWS then origWS = hum.WalkSpeed end
            hum.WalkSpeed = State.walkSpeed
        elseif origWS then
            hum.WalkSpeed = origWS origWS = nil
        end
        if State.jumpOn then
            if not origJP then origJP = hum.JumpPower origUse = hum.UseJumpPower end
            hum.UseJumpPower = true
            hum.JumpPower = State.jumpPower
        elseif origJP then
            hum.UseJumpPower = origUse
            hum.JumpPower = origJP
            origJP = nil
        end
        if State.bhop and hum.MoveDirection.Magnitude > 0
        and hum.FloorMaterial ~= Enum.Material.Air then
            hum.Jump = true
        end
    end

    if State.fly and hum and hrp then
        if not flyBV or flyBV.Parent ~= hrp then
            if flyBV then flyBV:Destroy() end
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            flyBV.Velocity = Vector3.zero
            flyBV.Parent = hrp
        end
        hum.PlatformStand = true
        flyWas = true
        local cam = workspace.CurrentCamera
        local v = Vector3.zero
        local md = hum.MoveDirection
        if cam and md.Magnitude > 0 then
            local rel = cam.CFrame:VectorToObjectSpace(md)
            v = (cam.CFrame.LookVector * -rel.Z + cam.CFrame.RightVector * rel.X) * State.flySpeed
        end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then v = v + Vector3.new(0, State.flySpeed, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then v = v - Vector3.new(0, State.flySpeed, 0) end
        flyBV.Velocity = v
    else
        if flyBV then flyBV:Destroy() flyBV = nil end
        if flyWas and hum then hum.PlatformStand = false end
        flyWas = false
    end
end

