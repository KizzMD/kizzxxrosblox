local function scanSkill()
    local lines = {}
    local pg = LP:FindFirstChild("PlayerGui")
    local ks = keyList(State.skillKeyword)
    local n = 0
    if pg then
        for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("GuiObject") or d:IsA("LayerCollector") then
                local nm = string.lower(d.Name)
                for _, k in ipairs(ks) do
                    if string.find(nm, k, 1, true) then
                        n = n + 1
                        if n <= 6 then
                            local extra = ""
                            if d:IsA("GuiObject") then
                                extra = ("vis=%s rot=%.0f"):format(tostring(d.Visible), d.AbsoluteRotation)
                            end
                            table.insert(lines, ("GUI %s %s %s"):format(d.ClassName, d:GetFullName(), extra))
                            for _, ch in ipairs(d:GetDescendants()) do
                                if ch:IsA("GuiObject") and #lines < 70 then
                                    table.insert(lines, ("  - %s %s rot=%.0f vis=%s"):format(
                                        ch.ClassName, ch.Name, ch.AbsoluteRotation, tostring(ch.Visible)))
                                end
                            end
                        end
                        break
                    end
                end
            end
        end
    end
    local rk = {"skill", "check", "gen", "repair", "heal", "qte"}
    for _, d in ipairs(RepStore:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
            local nm = string.lower(d.Name)
            for _, k in ipairs(rk) do
                if string.find(nm, k, 1, true) then
                    table.insert(lines, "REMOTE " .. d.ClassName .. " " .. d:GetFullName())
                    break
                end
            end
        end
    end
    if n == 0 then table.insert(lines, "(tidak ada GUI yang cocok dengan keyword)") end
    return lines
end

