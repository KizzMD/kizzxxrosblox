local function saveConfig()
    if not writefile then notify("writefile tidak didukung executor", true) return end
    local t = {}
    for _, k in ipairs(SAVE_KEYS) do t[k] = State[k] end
    local ok = pcall(function() writefile(CFG_FILE, HttpService:JSONEncode(t)) end)
    notify(ok and "Config disimpan" or "Gagal simpan config", true)
end

local function loadConfig()
    if not (readfile and isfile) then notify("readfile tidak didukung executor", true) return end
    local okf, has = pcall(isfile, CFG_FILE)
    if not (okf and has) then notify("Belum ada config tersimpan", true) return end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CFG_FILE)) end)
    if not ok or type(data) ~= "table" then notify("Config rusak", true) return end
    for _, k in ipairs(SAVE_KEYS) do
        if data[k] ~= nil and type(data[k]) == type(State[k]) then State[k] = data[k] end
    end
    for _, f in ipairs(refreshers) do pcall(f) end
    applyAll()
    notify("Config dimuat", true)
end

local function resetAll()
    for k, v in pairs(DEFAULTS) do State[k] = v end
    for _, f in ipairs(refreshers) do pcall(f) end
    applyAll()
    notify("Semua setting direset", true)
end

