        if input.KeyCode == Enum.KeyCode.Z then toggleKey("autoParry", "Auto Parry")
        elseif input.KeyCode == Enum.KeyCode.X then toggleKey("fly", "Fly")
        elseif input.KeyCode == Enum.KeyCode.C then toggleKey("noclip", "Noclip")
        elseif input.KeyCode == Enum.KeyCode.V then toggleKey("autoSkill", "Auto Skill") end
    end
end))

unload = function()
    running = false
    for _, k in ipairs({"walkSpeedOn", "jumpOn", "fly", "noclip", "fovOn", "bhop",
        "timeLock", "gravOn", "zoomUnlock", "volOn", "tracer", "autoSkill"}) do
        State[k] = false
    end
    pcall(playerTick)
    pcall(worldTick)
    pcall(noclipTick)
    pcall(fovTick)
    pcall(tracerTick)
    setFullbright(false)
    setNoFog(false)
    setFpsBoost(false)
    State.fpsCapOn = false
    applyFpsCap()
    stopView()
    unhookKiller()
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    if flyBV then pcall(function() flyBV:Destroy() end) end
    if tracerLine then pcall(function() tracerLine:Remove() end) end
    if ringPart then pcall(function() ringPart:Destroy() end) end
    gui:Destroy()
end

closeBtn.MouseButton1Click:Connect(function() unload() end)

lockBtn.MouseButton1Click:Connect(function()
    isLocked = not isLocked
    lockBtn.Text = isLocked and "🔒" or "🔓"
end)

local fDragging, fMoved, fStart, fStartPos = false, false, nil, nil
floatBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        fDragging = true
        fMoved    = false
        fStart    = input.Position
        fStartPos = floatBtn.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if not fDragging or isLocked then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - fStart
        if delta.Magnitude > 4 then fMoved = true end
        if fMoved then
            floatBtn.Position = UDim2.new(
                fStartPos.X.Scale, fStartPos.X.Offset + delta.X,
                fStartPos.Y.Scale, fStartPos.Y.Offset + delta.Y
            )
        end
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        if fDragging then
            if fMoved then
                floatPos = floatBtn.Position
                floatHasMoved = true
            else
                showMain()
            end
            fDragging = false
            fStart = nil
        end
    end
end)

local mDragging, mStart, mStartPos = false, nil, nil
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        mDragging = true
        mStart    = input.Position
        mStartPos = main.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if not mDragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - mStart
        main.Position = UDim2.new(
            mStartPos.X.Scale, mStartPos.X.Offset + delta.X,
            mStartPos.Y.Scale, mStartPos.Y.Offset + delta.Y
        )
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        mDragging = false
    end
end)

