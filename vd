-- slider global
local activeSlider = nil
local function isPointer(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch
end
local function isMove(i)
    return i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch
end
track(UIS.InputChanged:Connect(function(input)
    if activeSlider and isMove(input) then activeSlider(input.Position.X) end
end))
track(UIS.InputEnded:Connect(function(input)
    if activeSlider and isPointer(input) then
        activeSlider = nil
        for _, p in pairs(pages) do p.ScrollingEnabled = true end
    end
end))

local function makeSlider(parent, label, key, minV, maxV, step, opts, onChange)
    opts = opts or {}
    local hardMax = opts.hardMax or maxV
    local hardMin = opts.hardMin or minV

    local row = Instance.new("Frame")
    row.LayoutOrder = nextOrd()
    row.Size = UDim2.new(1, 0, 0, 52)
    row.BackgroundColor3 = T.panel
    row.BorderSizePixel = 0
    row.Parent = parent
    corner(row, 10)
    stroke(row, T.off, 1, 0.65)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -100, 0, 20)
    lbl.Position = UDim2.fromOffset(12, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = T.text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.Parent = row

    local box = Instance.new("TextBox")
    box.Size = UDim2.fromOffset(64, 20)
    box.Position = UDim2.new(1, -10, 0, 6)
    box.AnchorPoint = Vector2.new(1, 0)
    box.BackgroundColor3 = T.bg
    box.TextColor3 = T.text
    box.Font = Enum.Font.Code
    box.TextSize = 11
    box.BorderSizePixel = 0
    box.ClearTextOnFocus = false
    box.Text = tostring(State[key])
    box.Parent = row
    corner(box, 6)
    stroke(box, "a", 1, 0.6)

    local hit = Instance.new("TextButton")
    hit.Position = UDim2.new(0, 12, 0, 28)
    hit.Size = UDim2.new(1, -24, 0, 20)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.AutoButtonColor = false
    hit.Parent = row

    local trackF = Instance.new("Frame")
    trackF.AnchorPoint = Vector2.new(0, 0.5)
    trackF.Position = UDim2.new(0, 0, 0.5, 0)
    trackF.Size = UDim2.new(1, 0, 0, 6)
    trackF.BackgroundColor3 = T.off
    trackF.BorderSizePixel = 0
    trackF.Parent = hit
    corner(trackF, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.new(1, 1, 1)
    fill.BorderSizePixel = 0
    fill.Parent = trackF
    corner(fill, 3)
    local fg = Instance.new("UIGradient") fg.Parent = fill
    G(fg)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(1, 0, 0.5, 0)
    knob.Size = UDim2.fromOffset(14, 14)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = fill
    corner(knob, 7)
    stroke(knob, "a", 2, 0)

    local function render()
        local v = State[key]
        local rel = math.clamp((v - minV) / (maxV - minV), 0, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        box.Text = tostring(v)
    end
    local function setValue(v)
        v = tonumber(v)
        if not v then render() return end
        v = math.clamp(v, hardMin, hardMax)
        v = math.floor(v * 100 + 0.5) / 100
        State[key] = v
        render()
        if onChange then onChange(v) end
    end
    render()
    table.insert(refreshers, render)

    hit.InputBegan:Connect(function(input)
        if not isPointer(input) then return end
        activeSlider = function(x)
            local ax = trackF.AbsolutePosition.X
            local w = trackF.AbsoluteSize.X
            if w <= 0 then return end
            local rel = math.clamp((x - ax) / w, 0, 1)
            local v = minV + rel * (maxV - minV)
            v = math.floor(v / step + 0.5) * step
            setValue(v)
        end
        for _, p in pairs(pages) do p.ScrollingEnabled = false end
        activeSlider(input.Position.X)
    end)
    box.FocusLost:Connect(function() setValue(box.Text) end)
    return setValue
end

