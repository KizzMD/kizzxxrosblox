-- Fullbright
local lightBackup = nil
local function setFullbright(on)
    if on then
        if not lightBackup then
            lightBackup = {
                Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
                GlobalShading = Lighting.GlobalShading,
                Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
            }
        end
        pcall(function()
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.GlobalShading = false
            Lighting.Ambient = Color3.fromRGB(178, 178, 178)
            Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
        end)
    elseif lightBackup then
        for k, v in pairs(lightBackup) do pcall(function() Lighting[k] = v end) end
        lightBackup = nil
    end
end

-- No Fog
local fogBackup = nil
local function setNoFog(on)
    if on then
        if not fogBackup then
            local atm = Lighting:FindFirstChildOfClass("Atmosphere")
            fogBackup = {FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart,
                atm = atm, density = atm and atm.Density or 0}
        end
        pcall(function()
            Lighting.FogEnd = 1e6
            Lighting.FogStart = 1e6 - 1
            if fogBackup.atm then fogBackup.atm.Density = 0 end
        end)
    elseif fogBackup then
        pcall(function()
            Lighting.FogEnd = fogBackup.FogEnd
            Lighting.FogStart = fogBackup.FogStart
            if fogBackup.atm then fogBackup.atm.Density = fogBackup.density end
        end)
        fogBackup = nil
    end
end

-- FPS Boost
local boostBackup = nil
local function setFpsBoost(on)
    if on then
        if boostBackup then return end
        boostBackup = {shadows = Lighting.GlobalShadows, fx = {}, parts = {}}
        pcall(function()
            boostBackup.quality = settings().Rendering.QualityLevel
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        Lighting.GlobalShadows = false
        for _, d in ipairs(Lighting:GetChildren()) do
            if d:IsA("BloomEffect") or d:IsA("BlurEffect") or d:IsA("SunRaysEffect")
            or d:IsA("DepthOfFieldEffect") then
                if d.Enabled then boostBackup.fx[d] = true d.Enabled = false end
            end
        end
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke")
            or d:IsA("Fire") or d:IsA("Sparkles") then
                if d.Enabled then boostBackup.parts[d] = true d.Enabled = false end
            end
        end
    elseif boostBackup then
        pcall(function() Lighting.GlobalShadows = boostBackup.shadows end)
        if boostBackup.quality then
            pcall(function() settings().Rendering.QualityLevel = boostBackup.quality end)
        end
        for d in pairs(boostBackup.fx) do pcall(function() d.Enabled = true end) end
        for d in pairs(boostBackup.parts) do pcall(function() d.Enabled = true end) end
        boostBackup = nil
    end
end

